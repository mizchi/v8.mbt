import {
  "moonbitlang/async",
  "moonbitlang/core/debug",
}

supported_targets = "native"

options(
  "pre-build": [
    {
      "command": "bash src/scripts/build-rusty-v8.sh $output",
      "input": [ "../native/bridge/src/lib.rs", "scripts/build-rusty-v8.sh" ],
      "output": "build-stamps/rusty_v8_build.stamp",
    },
  ],
)
